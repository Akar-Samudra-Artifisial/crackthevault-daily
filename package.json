{
  "private": true,
  "name": "crackthevault-daily",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.ts' 'tools/**/*.ts'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "preview:ui": "vite tools/preview --port 5199 --strictPort",
    "sim": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/sim/vault-sim.ts",
    "test": "npm run test:unit",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "type-check": "tsc --build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.7"
  }
}